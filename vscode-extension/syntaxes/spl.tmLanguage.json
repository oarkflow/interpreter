{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL",
  "scopeName": "source.spl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.spl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.spl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.spl",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.spl",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.spl",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spl",
          "match": "\\b(?:if|else|while|for|do|in|break|continue|return|throw|try|catch|finally|switch|case|default|match|await|async|and|or|not)\\b"
        },
        {
          "name": "storage.type.spl",
          "match": "\\b(?:let|const|function|type|class|interface|import|export|from|as|init|test|new|lazy)\\b"
        },
        {
          "name": "constant.language.spl",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.spl",
          "match": "\\b(?:E|Error|INF|NAN|PI|abs|acos|add_months|all|any|api_key|asin|assert_contains|assert_eq|assert_neq|assert_throws|assert_true|atan|atan2|avg|await_all|await_race|background|base64_decode|base64_encode|basename|batch|bcrypt_hash|bcrypt_verify|camel_case|ceil|channel|chmod|chunk|clamp|coalesce|compact|computed|config_load|config_parse|constant_time_eq|contains|cos|cosh|count_substr|csv_decode|csv_encode|date_with_format|db_begin|db_close|db_commit|db_connect|db_exec|db_query|db_rollback|db_tables|decrypt|default|delete_key|dirname|effect|encrypt|end_of_day|end_of_month|ends_with|exec|exit|exp|file|file_bytes|file_copy|file_exists|file_load|file_mime|file_move|file_name|file_rename|file_save|file_size|file_text|find|first|flatten|floor|format_time|format_time_tz|ftp_get|ftp_list|ftp_put|generator|get|glob|go|go_async|group_by|has_key|hash|help|hex_decode|hex_encode|hmac|hmac_sha256|hmac_sha512|hot_reload|http_get|http_post|http_request|hypot|image|image_convert|image_convert_file|image_crop|image_info|image_load|image_render|image_resize|image_resize_file|image_rotate|image_save|immutable|index_of|input|interpolate|is_array|is_bool|is_even|is_float|is_function|is_hash|is_inf|is_int|is_nan|is_null|is_number|is_odd|is_string|iso_to_unix|iso_to_unix_ms|join|json_decode|json_encode|kebab_case|keys|last|len|listen|listen_async|log|log10|log2|lower|max|md5|merge|metric|middleware|min|mkdir|move|now|now_format|now_iso|os_env|pad_left|pad_right|parse_bool|parse_float|parse_int|parse_string|parse_time|parse_time_tz|parse_type|partition|pascal_case|password_generate|password_hash|password_verify|path_join|permissions|pow|print|printf|push|puts|query|lazy_query|random|random_bytes|random_range|random_string|range|read_csv|read_file|read_json|readdir|recv|reduce|regex_find_all|regex_match|regex_replace|regex_split|remove_file|render|repeat|replace|rest|reverse|rmdir|round|route|route_group|run_tests|schedule|schedule_cancel|schedule_interval|schedule_list|schedule_now|schedule_once|schedule_persist|schedule_restore|schedule_run|schedule_timezone|schedule_worker|secret|secret_mask|secret_reveal|seed_random|send|server|setSignal|sftp_get|sftp_list|sftp_put|sha256|sha512|shutdown|signal|sin|sinh|sleep|slice|slug|smtp_send|snake_case|sort|split|split_lines|sprintf|sqrt|start_of_day|start_of_week|starts_with|stat|static|substring|sum|swap_case|table_columns|table_filter|table_map|table_rows|table_select|tan|tanh|template_dir|test_summary|time|time_add|time_diff|time_format|time_ms|time_now|time_sub|title|to_degrees|to_float|to_int|to_radians|to_string|to_timezone|trace|trim|trim_prefix|trim_suffix|truncate|type|typeof|uniq|unix_ms_to_iso|unix_to_iso|unwatch|upper|url_decode|url_encode|uuid|values|watch|web_app|webhook|write_csv|write_file|write_json|zip)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.spl",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spl",
          "match": "(\\?\\?=|&&=|\\|\\|=|<<=|>>=|\\*\\*=|&=|\\|=|\\^=|\\?\\?|\\?\\.|\\|>|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|\\*\\*|\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\.\\.\\.|\\.\\.|[+\\-*/%<>=!&|^~?:.])"
        }
      ]
    }
  }
}
