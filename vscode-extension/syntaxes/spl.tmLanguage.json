{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL",
  "scopeName": "source.spl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#tool_modules"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "tool_modules": {
      "patterns": [
        {
          "name": "support.module.tools.spl",
          "match": "\"tools/(?:files|archive|images|office|secrets|media|system|network)\"|'tools/(?:files|archive|images|office|secrets|media|system|network)'"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.spl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.spl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.spl",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.spl",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.spl",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.spl",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spl",
          "match": "\\b(?:if|else|while|for|do|in|break|continue|return|throw|try|catch|finally|switch|case|default|match|await|async|and|or|not)\\b"
        },
        {
          "name": "storage.type.spl",
          "match": "\\b(?:let|const|function|type|class|interface|import|export|from|as|init|test|new|lazy)\\b"
        },
        {
          "name": "constant.language.spl",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.spl",
          "match": "\\b(?:E|Error|INF|NAN|PI|abs|acos|add_months|all|any|api_key|archive_compress|archive_extract|archive_list|asin|assert_contains|assert_eq|assert_neq|assert_throws|assert_true|atan|atan2|avg|await_all|await_race|background|base64_decode|base64_encode|basename|batch|bcrypt_hash|bcrypt_verify|bulk_rename|camel_case|cbrt|ceil|channel|chars|chmod|chunk|clamp|coalesce|compact|computed|config_load|config_parse|constant_time_eq|contains|cos|cosh|count_substr|csv_decode|csv_encode|date_with_format|db_begin|db_close|db_commit|db_connect|db_exec|db_query|db_rollback|db_tables|decrypt|deep_equal|default|delete_key|dirname|dns_lookup|drop|effect|encrypt|end_of_day|end_of_month|end_of_week|ends_with|entries|escape_html|exec|exit|exp|factorial|ffmpeg_install|ffmpeg_status|file|file_bytes|file_checksum|file_copy|file_copy_plan|file_decrypt|file_dedupe|file_encrypt|file_exists|file_load|file_locate|file_mime|file_move|file_move_plan|file_name|file_organize|file_remove_plan|file_rename|file_save|file_search|file_size|file_text|find|first|flatten|floor|format_duration|format_time|format_time_tz|from_entries|ftp_get|ftp_list|ftp_put|gcd|generator|get|glob|go|go_async|group_by|has_key|hash|help|hex_decode|hex_encode|hmac|hmac_sha256|hmac_sha512|hot_reload|http_get|http_post|http_probe|http_request|hypot|image|image_convert|image_convert_batch|image_convert_file|image_crop|image_crop_file|image_info|image_info_file|image_load|image_optimize|image_render|image_resize|image_resize_file|image_rotate|image_save|image_thumbnail|immutable|index_by|index_of|input|interpolate|is_alnum|is_alpha|is_array|is_blank|is_bool|is_even|is_finite|is_float|is_function|is_hash|is_inf|is_int|is_integer|is_nan|is_null|is_number|is_numeric|is_odd|is_prime|is_string|is_weekend|iso_to_unix|iso_to_unix_ms|join|json_decode|json_encode|json_parse|json_stringify|kebab_case|keys|last|last_index_of|lcm|len|lerp|listen|listen_async|log|log10|log2|lower|map_range|max|md5|mean|media_convert|media_info|median|merge|metric|middleware|min|mkdir|mod|mode|month|move|normalize|now|now_format|now_iso|office_read|office_text|omit|os_env|pad_left|pad_right|parse_bool|parse_duration|parse_float|parse_int|parse_string|parse_time|parse_time_tz|parse_type|partition|pascal_case|password_generate|password_hash|password_verify|path_abs|path_base|path_clean|path_dir|path_ext|path_join|percent|percentile|permissions|pick|pluck|pow|print|printf|push|puts|query|lazy_query|random|random_bytes|random_choice|random_float|random_range|random_string|range|read_csv|read_file|read_json|readdir|recv|reduce|regex_find_all|regex_match|regex_replace|regex_split|remove_file|render|repeat|replace|replace_n|rest|reverse|reverse_string|rmdir|round|round_to|route|route_group|run_tests|sample|schedule|schedule_cancel|schedule_interval|schedule_list|schedule_now|schedule_once|schedule_persist|schedule_restore|schedule_run|schedule_timezone|schedule_worker|secret|secret_generate|secret_mask|secret_reveal|seed_random|send|server|setSignal|sftp_get|sftp_list|sftp_put|sha256|sha512|shuffle|shutdown|sign|signal|sin|sinh|sleep|slice|slug|smtp_send|snake_case|sort|sort_by|split|split_lines|sprintf|sqrt|start_of_day|start_of_month|start_of_week|starts_with|stat|static|stddev|substring|sum|swap_case|system_info|table_columns|table_filter|table_map|table_rows|table_select|take|tan|tanh|tcp_check|template_dir|test_summary|time|time_add|time_diff|time_format|time_ms|time_now|time_sub|title|to_degrees|to_float|to_int|to_radians|to_string|to_timezone|token_generate|trace|trim|trim_chars|trim_prefix|trim_suffix|trunc|truncate|type|typeof|unescape_html|uniq|unique|unix_ms_to_iso|unix_to_iso|unwatch|upper|url_decode|url_encode|uuid|values|variance|watch|web_app|webhook|weekday|words|write_csv|write_file|write_json|year|zip)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.spl",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spl",
          "match": "(\\?\\?=|&&=|\\|\\|=|<<=|>>=|\\*\\*=|&=|\\|=|\\^=|\\?\\?|\\?\\.|\\|>|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|\\*\\*|\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\.\\.\\.|\\.\\.|[+\\-*/%<>=!&|^~?:.])"
        }
      ]
    }
  }
}
