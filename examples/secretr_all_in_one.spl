// SPL secretr builtins tour (builtins/secretr, wrapping the private,
// local-only github.com/oarkflow/secretr).
//
// Build and run from the repository root:
//   cd cmd/interpreter-full && go build -tags dev -o ../../bin/interpreter-full . && cd ../..
//   ./bin/interpreter-full examples/secretr_all_in_one.spl
//
// -tags dev matters here specifically (see builtins/secretr/README.md):
// it keeps secretr's own licensing checks out of the picture for this kind
// of local/embedded use. Vault data is written under ./.secretr-data
// (relative to the repo root) unless SECRETR_DATA_DIR is set.
//
// secretr builtins are only linked into cmd/interpreter-full (not the
// lightweight cmd/interpreter), same as builtins/pdf - see that plugin's
// README for why heavier optional dependencies stay out of the
// lightweight binary.

import "secretr" as secretr;

print "=== SPL secretr Builtins Tour ===";

// -----------------------------------------------------------------------------
// 1) Store and fetch a secret - never hardcode the value itself
// -----------------------------------------------------------------------------
print "--- 1) secretr_set / secretr_get ---";

secretr.set("demo/api-key", "sk_live_demo_only_not_real");

let apiKey = secretr.get("demo/api-key");
print sprintf("apiKey prints masked: %v", apiKey);        // *** - SECRET values never print in plain text
print sprintf("apiKey revealed: %s", secret_reveal(apiKey));

// secretr_set also accepts an existing SECRET value directly, e.g. one
// produced by secret(...) or a config_load() secret-wrapped field:
secretr.set("demo/rotated-key", secret("rotate-me-later"));
print sprintf("rotated key revealed: %s", secret_reveal(secretr.get("demo/rotated-key")));

// -----------------------------------------------------------------------------
// 2) Dot notation: group related values under one vault entry
// -----------------------------------------------------------------------------
print "--- 2) dot-notation nesting ---";

secretr.set("demo.database.password", "hunter2");
secretr.set("demo.database.host", "localhost");
print sprintf("database.password: %s", secret_reveal(secretr.get("demo.database.password")));
print sprintf("database.host: %s", secret_reveal(secretr.get("demo.database.host")));
// Both calls above stored into ONE top-level secret named "demo" (a JSON
// object with a nested "database" key) - see the README's "Dot notation"
// section for why secretr.list() below shows "demo", not
// "demo.database.password"/"demo.database.host" individually.

// -----------------------------------------------------------------------------
// 3) List and delete
// -----------------------------------------------------------------------------
print "--- 3) secretr_list / secretr_delete ---";

let names = secretr.list("demo");
print sprintf("secret names starting with \"demo\": %v", names);

secretr.delete("demo/rotated-key");
print sprintf("after delete: %v", secretr.list("demo"));

// -----------------------------------------------------------------------------
// 4) Scan arbitrary text for hardcoded-secret-shaped strings
// -----------------------------------------------------------------------------
print "--- 4) secretr_scan ---";

let suspicious = "aws_key = \"AKIAABCDEFGHIJKLMNOP\"\ngithub = \"ghp_123456789012345678901234567890123456\"";
let findings = secretr.scan(suspicious);
print sprintf("findings in suspicious text: %v", findings);

let clean = "let name = \"Ada Lovelace\"; let age = 36;";
print sprintf("findings in clean text: %v", secretr.scan(clean));

// -----------------------------------------------------------------------------
// 5) BlockHardcodedSecrets: refuse to even run a script that hardcodes one
// -----------------------------------------------------------------------------
// This is enforced at the interpreter level (interpreter.ExecWithOptions,
// the CLI, and the playground's quick-eval mode all check before parsing),
// not by a builtin call - so it can't be demonstrated by a line in *this*
// script (this script isn't hardcoding a real-shaped secret literal to
// begin with). Turn it on for any run via:
//
//   SPL_BLOCK_HARDCODED_SECRETS=true ./bin/interpreter-full some_script.spl
//
// A script containing e.g. `let key = "AKIAABCDEFGHIJKLMNOP";` is then
// rejected before it runs, with a message pointing at secretr_set/get
// instead. See builtins/secretr's tests (TestBlockHardcodedSecretsRejectsScript)
// for a full round-trip example.

print "=== Tour complete ===";
