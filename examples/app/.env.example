# Copy to .env and adjust. app/config/app.spl loads this via config_load()
# and falls back to built-in defaults for anything missing, so the app also
# runs with no .env file present at all (e.g. the single-binary build).
APP_NAME=SPL Todo App
APP_PORT=8080
APP_ENV=development
VIEWS_DIR=app/views
PUBLIC_DIR=public

# SQLite file, resolved relative to the process's working directory (same
# rule as VIEWS_DIR/PUBLIC_DIR - see README's "Run it" section). Use
# ":memory:" for a throwaway database, or an absolute path if you want the
# single-binary build's data to survive past its temp-directory lifetime.
DB_PATH=storage/app.db

# Any key containing "token" is automatically masked as a SECRET by
# config_load() - it prints as *** and must be unwrapped with
# secret_reveal() before use (see app/middleware/auth.spl). Required to
# call the admin-only routes (e.g. POST /api/admin/worker/stop).
ADMIN_TOKEN=change-me-admin-token
