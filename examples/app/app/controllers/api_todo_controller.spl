import "@/models/todo.spl" as Todo;
import "@/support/events.spl" as events;
import "@/support/http.spl" as http;
import "@/support/types.spl" as types;

export function index(req, res) {
  let filter = http.query_as(req, types.TodoFilter);
  let items = Todo.all_by_priority().filter(function(t) { return filter.matches(t); });
  res.json({"data": items});
}

export function show(req, res) {
  let id = http.parse_id(req.param("id"));
  if (id == null) {
    res.status(400).json({"error": "invalid id"});
    return;
  }
  let t = Todo.find(id);
  if (t == null) {
    res.status(404).json({"error": "not found"});
    return;
  }
  res.json({"data": t});
}

export function store(req, res) {
  let input = http.body_as(req, types.TodoInput);
  if (input == null) {
    res.status(400).json({"error": "invalid JSON body"});
    return;
  }
  match (input.validate()) {
    case Valid(v) => {
      let t = Todo.create({"title": v.title, "priority": v.priority});
      events.publish("todo.created", sprintf("created #%d \"%s\" (%s)", t.id, t.title, t.priority));
      res.status(201).json({"data": t});
    }
    case Invalid(reason) => {
      res.status(422).json({"error": reason});
    }
  }
}

export function update(req, res) {
  let id = http.parse_id(req.param("id"));
  if (id == null) {
    res.status(400).json({"error": "invalid id"});
    return;
  }
  // Partial update (any subset of fields), so this intentionally doesn't
  // go through TodoInput - that type requires a title, but PATCH-style
  // updates need to allow omitting it. Todo.update() already treats a
  // missing field as "leave unchanged".
  let body = req.json();
  if (body == null) {
    res.status(400).json({"error": "invalid JSON body"});
    return;
  }
  let t = Todo.update(id, body);
  if (t == null) {
    res.status(404).json({"error": "not found"});
    return;
  }
  events.publish("todo.updated", sprintf("updated #%d \"%s\"", t.id, t.title));
  res.json({"data": t});
}

export function destroy(req, res) {
  let id = http.parse_id(req.param("id"));
  if (id == null) {
    res.status(400).json({"error": "invalid id"});
    return;
  }
  let removed = Todo.destroy(id);
  if (!removed) {
    res.status(404).json({"error": "not found"});
    return;
  }
  events.publish("todo.deleted", sprintf("deleted #%d", id));
  res.status(204).send("");
}
