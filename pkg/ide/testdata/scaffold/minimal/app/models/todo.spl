// In-memory Todo model. cmd/interpreter (lightweight) has no SQLite driver
// linked, so storage here is a plain in-memory array instead of a real
// database - swap this file for a SQLite-backed one (see the "app" project
// kind, which mirrors examples/app/app/models/todo.spl) once you need
// storage to survive a restart.
let todos = [];
let next_id = 1;

export function normalize_priority(p) {
  if (p == "low" or p == "medium" or p == "high") {
    return p;
  }
  return "medium";
}

function priority_rank(p) {
  if (p == "high") {
    return 3;
  }
  if (p == "medium") {
    return 2;
  }
  if (p == "low") {
    return 1;
  }
  return 0;
}

export function all() {
  return todos;
}

// all_by_priority buckets by priority_rank and flattens high-to-low -
// Array.sort() only supports default type-based ordering (no custom
// comparator), so a bucket pass is used instead of a comparator sort.
export function all_by_priority() {
  let buckets = [[], [], [], []];
  for (t in todos) {
    buckets[priority_rank(t.priority)].push(t);
  }
  let result = [];
  let rank = 3;
  while (rank >= 0) {
    for (t in buckets[rank]) {
      result.push(t);
    }
    rank = rank - 1;
  }
  return result;
}

export function find(id) {
  for (t in todos) {
    if (t.id == id) {
      return t;
    }
  }
  return null;
}

export function create(data) {
  let t = {
    "id": next_id,
    "title": data.title,
    "priority": normalize_priority(data.priority),
    "done": false,
    "created_at": now_iso()
  };
  next_id = next_id + 1;
  todos.push(t);
  return t;
}

export function update(id, data) {
  for (let i = 0; i < len(todos); i = i + 1) {
    if (todos[i].id == id) {
      let existing = todos[i];
      let title = data.title != null ? data.title : existing.title;
      let priority = data.priority != null ? normalize_priority(data.priority) : existing.priority;
      let done = data.done != null ? data.done : existing.done;
      let updated = {
        "id": id,
        "title": title,
        "priority": priority,
        "done": done,
        "created_at": existing.created_at
      };
      todos[i] = updated;
      return updated;
    }
  }
  return null;
}

export function destroy(id) {
  let existing = find(id);
  if (existing == null) {
    return false;
  }
  todos = todos.filter(function(t) {
    return t.id != id;
  });
  return true;
}
