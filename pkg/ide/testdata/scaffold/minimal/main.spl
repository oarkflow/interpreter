// Single entry point for the app.
//
// Run with:
//   go run ./cmd/interpreter main.spl
//
// This scaffold uses only builtins linked into the lightweight
// cmd/interpreter binary - no database, no builtins/template - so it stays
// runnable from the IDE's "minimal" project kind. See app/models/todo.spl
// for the in-memory storage this implies.
//
// Boot order: config -> middleware -> routes -> static -> listen.
import "server" as server;
import "@/config/app.spl" as config;
import "@/middleware/logger.spl" as logger;
import "@/routes/web.spl" as web;
import "@/routes/api.spl" as api;

let app = server.web_app(config.VIEWS_DIR);

server.middleware(app, logger.log_request);
server.static(app, "/public/", config.PUBLIC_DIR);

web.register(app);
api.register(app);

print sprintf("%s (%s) booting...", config.APP_NAME, config.APP_ENV);
server.listen(app, config.APP_PORT);
