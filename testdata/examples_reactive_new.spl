// =============================================================================
// Feature 1: Reactive System + Template SSR/Hydration
// Run: go run ./cmd/interpreter testdata/examples_reactive_new.spl
// =============================================================================

print "=== SPL Reactive System ===";

print "--- Runtime signals ---";
let count = signal("count", 1);
let name = signal("name", "Ada");

let label = computed(function() {
    return name.value + " clicked " + count.value + " times";
});

let tracker = effect(function() {
    print "[effect] " + label.value;
});

count.set(2);
name.set("Grace");
batch(function() {
    count.set(3);
    name.set("Linus");
});
tracker.dispose();

print "signal count=" + count.value;
print "computed label=" + label.value;

print "\n--- Template directives now supported ---";
print "Use these in template files rendered through the web layer:";
print "  @signal(count = 3)";
print "  <div>@bind(count)</div>";
print "  @effect(count) {<span>${count}</span>}";
print "  @lazy(showExtra) {<aside>Visible</aside>} @fallback {<aside>Hidden</aside>}";

print "\n--- Example SSR template snippet ---";
print "@signal(counter = 5)";
print "<h1>Counter: @bind(counter)</h1>";
print "@effect(counter) {<strong>${counter}</strong>}";

print "\n--- Renderable preview artifact ---";
let reactivePreview = """
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SPL reactive preview</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f8fafc;
      color: #172033;
    }
    main {
      width: min(92vw, 520px);
      border: 1px solid #dbe3ef;
      border-radius: 8px;
      background: white;
      padding: 24px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
    }
    h1 {
      margin: 0 0 12px;
      font-size: 24px;
      line-height: 1.2;
    }
    .value {
      display: inline-flex;
      min-width: 44px;
      justify-content: center;
      border-radius: 6px;
      background: #0f766e;
      color: white;
      padding: 2px 8px;
      font-weight: 700;
    }
    code {
      display: block;
      margin-top: 16px;
      border-radius: 6px;
      background: #101827;
      color: #d7e1ee;
      padding: 14px;
      white-space: pre-wrap;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <main>
    <h1>Counter: <span class="value">5</span></h1>
    <p>This is the shape that the reactive template directives should produce after SSR and hydration.</p>
    <code>@signal(counter = 5)
<h1>Counter: @bind(counter)</h1>
@effect(counter) {<strong>${counter}</strong>}</code>
  </main>
</body>
</html>
""";

print render(reactivePreview, {
    "name": "reactive-preview.html",
    "mime": "text/html",
    "mode": "metadata"
});

print "\nHydration behavior:";
print "  - signals are serialized into the page";
print "  - @bind wires DOM updates and input[value] two-way sync";
print "  - @effect emits hydrated DOM islands that re-render on signal updates";

print "\n=== Reactive Examples Complete ===";
