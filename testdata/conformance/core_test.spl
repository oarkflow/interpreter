test "arithmetic and precedence" {
  assert_eq(1 + 2 * 3, 7);
  assert_eq((1 + 2) * 3, 9);
}

test "closures capture lexical scope" {
  let makeAdder = function(x) {
    return function(y) { x + y; };
  };
  let add10 = makeAdder(10);
  assert_eq(add10(5), 15);
}

test "arrays and hashes" {
  let nums = [1, 2, 3];
  let obj = {"name": "spl", "count": len(nums)};
  assert_eq(nums[1], 2);
  assert_eq(obj.count, 3);
}

